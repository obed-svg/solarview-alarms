# Copiar a .env.production en la EC2. No commitear el archivo real.

# Dominio público. Debe resolver hacia la Elastic IP de la EC2.
PUBLIC_HOST=alarmas.example.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
ALLOWED_HOSTS=alarmas.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://alarmas.example.com
SECRET_KEY=reemplazar-por-un-valor-largo-y-aleatorio
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0

# Imagen y procesos
IMAGE_TAG=local
GUNICORN_WORKERS=2
CELERY_WORKER_CONCURRENCY=2

# Base de datos interna del Compose
POSTGRES_DB=solarview_alarms
POSTGRES_USER=solarview
POSTGRES_PASSWORD=reemplazar-por-una-clave-larga-y-aleatoria

# SolarView
SOLARVIEW_BASE_URL=api.sole.tech
static_token=

# Discord: los nombres en minúscula son los esperados por Django.
webhook_discord=
discord_bot_token=
discord_application_id=
discord_public_key=
discord_guild_id=

# WhatsApp permanece sin configurar y sus canales deben seguir deshabilitados.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
